{
  "expo": {
    "name": "Fixhub",
    "slug": "service-connect",
    "scheme": "serviceconnect",
    "description": "Discover and connect with trusted local service professionals.",
    "version": "1.0.0",
    "orientation": "portrait",
          "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.serviceconnect.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.serviceconnect.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/app-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fixhub uses your photos to upload CNIC pictures.",
          "cameraPermission": "Fixhub uses your camera to take CNIC pictures.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fixhub uses your location to set your service area."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0ac92273-6ffb-4b63-96ee-25bdfa2717fb"
      }
    },
    "owner": "huzaifasidd"
  }
}
